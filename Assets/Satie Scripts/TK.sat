group intro
    loop ambience/forest
        volume goto(0and0.1 in 80)
        pitch 0.5
        filter mode lowpass cutoff goto(18000and100 as inoutquad in 300)

    oneshot water/1to4
        volume goto(0and0.5 in 20)
        pitch goto(0.7and1 as incubic in 15)
        move x -10to10 z -10to10 speed 0.1
        visual trail
        color blue
        filter mode lowpass cutoff goto(18000and100 as inoutquad in 80)
    oneshot ambience/rain
        start 20
        volume goto(0and0.5 in 40)
        pitch 1
        filter mode lowpass cutoff goto(18000and100 as inoutquad in 100)

    oneshot sacred/bells
        start 40
        volume goto(0and0.5 in 20)
        move fly speed 0.5
        delay wet 0.3 time 0.5to0.9 feedback 0.2to0.5
        visual trail
        color white

    oneshot sacred/mastermonk
        start 60
        volume goto(0and0.2 in 20)
        pitch goto(0and1 as incubic in 20)
        delay wet 0.3 time 0.5to0.9 feedback 0.2to0.5
        move fly speed 0.5
        visual trail
        color white

    oneshot ambience/playground
        start 100
        volume goto(0and0.2 in 40)
        pitch 1
        filter mode lowpass cutoff goto(18000and100 as inoutquad in 100)
        persistent

    oneshot piece/13
        start 140
        volume goto(0and0.3 in 40)

    oneshot campfire
        start 120
        volume goto(0and0.3 in 40)
        filter mode lowpass cutoff goto(18000and100 as inoutquad in 100)
    

10 * oneshot tk/1to90 every 3to10
    start 160
    volume 0.2to1
    pitch 0.8to1.2
    move x -10to10 y 0to10 z -10to10 speed 1to3
    visual trail
    color red gobetween(100and255 as inoutquad in 15) green 0 blue 200
    filter mode lowpass cutoff goto(18000and100 as inoutquad in 100)

5 * oneshot piano/1to56 every 5to10
    start 180
    volume 0.5to1
    randomstart
    pitch 0.8to1.2
    move x -10to10 y 0to20 z -10to20 speed 1to3
    visual trail and sphere
    color yellow
    filter mode lowpass cutoff goto(18000and100 as inoutquad in 100)

5 * oneshot ppiano/1to46 every 5to10
    start 200
    volume 0.5to0.8
    randomstart
    pitch 0.8to1.2
    move x -10to10 y 0to20 z -10to20 speed 5
    visual trail and sphere
    color red 100 green 25 blue gobetween(100and255 as inoutquad in 15)
    filter mode lowpass cutoff goto(18000and100 as inoutquad in 100)
