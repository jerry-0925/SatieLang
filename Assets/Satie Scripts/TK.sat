group hello
volume goto(0and0.5 in 10)
    loop ambience/forest
        volume 0.08
        filter mode lowpass cutoff 2000

    loop ambience/rain
        volume goto(0and0.1 in 5)

    loop drone
        volume 0.3

    3 * oneshot animal/bird/1 every 4to9
        volume 0.05to0.1
        move fly
        visual trail
        color red gobetween(0and255 in 8) green gobetween(0and255 in 10) blue gobetween(0and255 in 12)

    2 * oneshot animal/bird/2 every 5to10
        volume 0.04to0.08
        move fly
        visual trail
        color red gobetween(0and255 in 7) green gobetween(0and255 in 9) blue gobetween(0and255 in 11)

    oneshot animal/bird/3 every 6to12
        volume 0.05to0.09
        move fly
        visual trail
        color red gobetween(0and255 in 9) green gobetween(0and255 in 11) blue gobetween(0and255 in 13)