comment
loop "ambience/water":
    volume = 0.2
    move = x -5to5 y 0to5 speed gobetween(0.0001and1 in 10)
    visual = trail
    move = fly 
    move = x gobetween(-1and-0.5)to1 and y 0to5 at speed 2 
    move = x -1to1 and y -1to1 and z 0to2 at speed 1 
    move = x -5to5 
    move = y 0to5 
    move = walk 
    move = fly 
    move = x -5to5 and y 0to5 at speed 2 
    move = x -1to1 and y -1to1 and z 0to2 at speed 1 
    move = x -5to5 
    move = y 0to5 
    move = z 0to5 

    move = x gobetween(-1and-0.5 in 10)to1 and y 0to5 at speed 2
    move = x -1to1 y -1to1 z 0to2 at speed goto(0.1and10 as inquad in 10)
endcomment

loop ambience/forest
    volume 0.2
    pitch 0.6
    visual cube
    color white


# color
group music
volume 1
color red 255 green gobetween(40and255 in 10) blue gobetween(0and100 in 10)
    5 * oneshot piano/1to5 every 4to10
        volume 0.2 
        pitch 0.5to1.2
        move x -10to10 z -10to10 speed 1
        visual trail and cube

    2 * oneshot tomek/1to5 every 4to10
        volume 0.2 
        pitch 0.5to1.2
        move x -10to10 z -10to10 speed 1
        visual trail

