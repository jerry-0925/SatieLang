10 * oneshot "voice/1to40" every 5:
    volume = goto(0and0.4 as inquad in 0.5)
    move = fly, -10to10, 0to5, -10to10, 1to5
    visual = trail


5 * oneshot "tomek/1to94" every 5to10:
    volume = goto(0and0.4 as inquad in 0.5)
    move = walk, -10to10, -10to10, 1to5
    visual = cube

loop "ambience/rain":
    volume = goto(0and0.2 as inquad in 15)

4 * oneshot "generation/mad_laugh" every 15to30:
    volume = goto(0and0.28 as inquad in 1)
    pitch = gobetween(0.2and1.2 as incubic in 2)
    move = walk, -5to5, -5to5, 0.5to3
    visual = sphere