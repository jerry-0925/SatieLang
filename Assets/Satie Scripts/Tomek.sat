group ambience
volume gobetween(0.1and0.5 as inquad in 100)
    loop ambience/forest
        volume goto(0and0.1 in 20)
        persistent

    loop ambience/water
        volume goto(0and0.4 in 20)
        filter mode lowpass cutoff gobetween(200and2000 in 20)
        move walk
        visual = cube
        persistent

    4 * oneshot bird/1to5 every 10to20
        volume 0.01to0.2
        pitch 0.6to0.8
        move fly
        visual trail
        color red 255 green 0 blue gobetween(0and200 in 5)

    oneshot animals/cicada every 15to30
        volume 0.05to0.2
        pitch 0.8to1.2
    
endgroup


10 * oneshot tomek/1to94 every 5to15
    volume goto(0and0.4 as inquad in 0.5)
    pitch 0.8to1.2
    delay wet 0.2 time 0.5to0.9 feedback 0.2to0.5
    comment
    filter mode highpass cutoff gobetween(5000and15000 in 5)
    reverb wet gobetween(0.1and1 in 10) size 0.8
    endcomment
    move fly
    visual trail and sphere
    color red 0 green 0 blue gobetween(0and200 in 5)

2 * oneshot ppiano/1to46 every 15to25
    volume goto(0and0.4 as inquad in 0.5)
    pitch 0.8to1.2
    move y -10to10 speed 1
    visual trail and sphere
    color red 0 green 0 blue gobetween(0and200 in 5)


comment
loop sacred/1
    volume goto(0and0.01 as insine every 20)
    move walk
    visual sphere
    filter mode lowpass cutoff 12000


loop sacred/monks
    volume goto(0and0.05 in 20)
    move walk
    visual sphere

loop sacred/bells
    volume goto(0and0.01 in 20)
    move walk
    visual sphere
    reverb wet 0.5 size 0.8
endcomment




